  "info": {
    "title": "Zot API",
    "description": "#### Overview\nZot API provides a comprehensive solution for managing waitlists and user authentication\n\n#### Rate Limiting\nAPI requests are subject to rate limiting. Please handle 429 responses appropriately.",
    "version": "1.0.0",
    "contact": {
      "name": "Zot Team",
      "url": "https://zot.so",
      "email": "support@zot.so"
    }
  },
  "tags": [
    {
      "name": "Health",
      "description": "API health check endpoints"
    },
    {
      "name": "Auth",
      "description": "Authentication and authorization endpoints"
    },
    {
      "name": "Subscriptions",
      "description": "Stripe subscription and billing endpoints"
    },
    {
      "name": "WaitList",
      "description": "Waitlist management endpoints"
    },
    {
      "name": "WaitList Users",
      "description": "Waitlist user registration and management"
    },
    {
      "name": "React to HTML",
      "description": "React component to HTML conversion"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3010",
      "description": "Current Environment"
    }
  ],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "Authorization",
        "description": "Enter your JWT token",
        "in": "header"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "User email address",
            "example": "john.doe@example.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "User password",
            "example": "SecureP@ssw0rd!",
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AccessTokenResponseDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT access token for authenticated requests",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": [
          "access_token"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "User first name",
            "example": "John",
            "minLength": 2
          },
          "lastName": {
            "type": "string",
            "description": "User last name",
            "example": "Doe",
            "minLength": 2
          },
          "email": {
            "type": "string",
            "description": "User email address (must be unique)",
            "example": "john.doe@example.com",
            "maxLength": 100,
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "User password",
            "example": "SecureP@ssw0rd!",
            "maxLength": 100,
            "format": "password"
          },
          "avatar": {
            "type": "string",
            "description": "URL to user avatar image",
            "example": "https://example.com/avatars/john-doe.jpg",
            "format": "uri"
          }
        },
        "required": [
          "name",
          "lastName",
          "email",
          "password"
        ]
      },
      "UserProfileResponseDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "User unique identifier",
            "example": "507f1f77bcf86cd799439011"
          }
        },
        "required": [
          "userId"
        ]
      },
      "LogoutResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Logout confirmation message",
            "example": "Logged out successfully"
          }
        },
        "required": [
          "message"
        ]
      },
      "CreateApiKeyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name to identify the API key",
            "example": "Production API Key",
            "minLength": 2,
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ]
      },
      "ObjectId": {
        "type": "object",
        "properties": {}
      },
      "UpdateApiKeyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name to identify the API key",
            "example": "Production API Key",
            "minLength": 2,
            "maxLength": 100
          }
        }
      },
      "ReactToHtmlDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "React component code to be compiled to HTML",
            "example": "import { Html, Head, Body, Container, Text } from \"@react-email/components\";\n\nexport default function Email() {\n  return (\n    <Html>\n      <Head />\n      <Body>\n        <Container>\n          <Text>Hello World!</Text>\n        </Container>\n      </Body>\n    </Html>\n  );\n}"
          }
        },
        "required": [
          "code"
        ]
      },
      "ReactToHtmlResponseDto": {
        "type": "object",
        "properties": {
          "html": {
            "type": "string",
            "description": "Compiled HTML output from React component",
            "example": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html>\n  <head></head>\n  <body>\n    <div style=\"max-width:600px;margin:0 auto\">\n      <p>Hello World!</p>\n    </div>\n  </body>\n</html>"
          }
        },
        "required": [
          "html"
        ]
      },
      "CreateCheckoutSessionDto": {
        "type": "object",
        "properties": {
          "couponCode": {
            "type": "string",
            "description": "Optional promotion code to apply immediately. If omitted, Stripe Checkout still allows entering a code manually.",
            "example": "WELCOME10"
          }
        }
      },
      "CheckoutSessionResponseDto": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "Checkout session id generated by Stripe",
            "example": "cs_test_a1B2c3D4e5"
          },
          "url": {
            "type": "string",
            "description": "Stripe-hosted URL where the user completes the subscription purchase",
            "example": "https://checkout.stripe.com/c/pay/cs_test_123"
          }
        },
        "required": [
          "sessionId",
          "url"
        ]
      },
      "WebhookAcceptedResponseDto": {
        "type": "object",
        "properties": {
          "received": {
            "type": "boolean",
            "description": "Indicates that webhook event was accepted",
            "example": true
          }
        },
        "required": [
          "received"
        ]
      },
      "WebhookConfigDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Webhook URL to notify when a new user signs up",
            "example": "https://your-server.com/webhooks/waitlist",
            "format": "uri"
          },
          "range": {
            "type": "number",
            "description": "Notify webhook every N users registered",
            "example": 10,
            "default": 10
          }
        }
      },
      "CreateWaitListDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the waitlist",
            "example": "Product Launch Waitlist"
          },
          "sendEmailToNewSignup": {
            "type": "boolean",
            "description": "Whether to send confirmation email to new signups",
            "example": true
          },
          "webhook": {
            "description": "Webhook configuration for new signup notifications",
            "allOf": [
              {
                "$ref": "#/components/schemas/WebhookConfigDto"
              }
            ]
          },
          "widget_id": {
            "type": "string",
            "description": "Associated widget ID for embedding",
            "example": "507f1f77bcf86cd799439011"
          },
          "isAvailable": {
            "type": "boolean",
            "description": "Whether the waitlist is accepting new signups",
            "example": true,
            "default": true
          },
          "isSecurityActive": {
            "type": "boolean",
            "description": "Whether the waitlist has security active",
            "example": true,
            "default": false
          }
        },
        "required": [
          "name",
          "sendEmailToNewSignup"
        ]
      },
      "WaitListResponseDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Unique identifier of the waitlist",
            "example": "507f1f77bcf86cd799439011"
          },
          "name": {
            "type": "string",
            "description": "Name of the waitlist",
            "example": "Product Launch Waitlist"
          },
          "sendEmailToNewSignup": {
            "type": "boolean",
            "description": "Whether confirmation emails are sent to new signups",
            "example": true
          },
          "webhook": {
            "type": "object",
            "description": "Webhook URL for new signup notifications",
            "example": "https://your-server.com/webhooks/waitlist",
            "format": "uri"
          },
          "widget_id": {
            "type": "string",
            "description": "Associated widget ID",
            "example": "507f1f77bcf86cd799439011"
          },
          "isAvailable": {
            "type": "boolean",
            "description": "Whether the waitlist is accepting signups",
            "example": true
          },
          "user_id": {
            "type": "string",
            "description": "Owner user ID",
            "example": "507f1f77bcf86cd799439011"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Creation timestamp",
            "example": "2024-01-15T10:30:00.000Z"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "description": "Last update timestamp",
            "example": "2024-01-15T10:30:00.000Z"
          }
        },
        "required": [
          "_id",
          "name",
          "sendEmailToNewSignup",
          "isAvailable",
          "user_id",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateWaitListDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the waitlist",
            "example": "Product Launch Waitlist"
          },
          "sendEmailToNewSignup": {
            "type": "boolean",
            "description": "Whether to send confirmation email to new signups",
            "example": true
          },
          "webhook": {
            "description": "Webhook configuration for new signup notifications",
            "allOf": [
              {
                "$ref": "#/components/schemas/WebhookConfigDto"
              }
            ]
          },
          "widget_id": {
            "type": "string",
            "description": "Associated widget ID for embedding",
            "example": "507f1f77bcf86cd799439011"
          },
          "isAvailable": {
            "type": "boolean",
            "description": "Whether the waitlist is accepting new signups",
            "example": true,
            "default": true
          },
          "isSecurityActive": {
            "type": "boolean",
            "description": "Whether the waitlist has security active",
            "example": true,
            "default": false
          }
        }
      },
      "RegisterWaitListUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email address of the user joining the waitlist",
            "example": "user@example.com",
            "format": "email"
          },
          "referredBy": {
            "type": "string",
            "description": "Referral code from another user who referred this signup",
            "example": "ref_abc123xyz"
          }
        },
        "required": [
          "email"
        ]
      },
      "WaitListUserResponseDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Unique identifier of the waitlist user entry",
            "example": "507f1f77bcf86cd799439011"
          },
          "email": {
            "type": "string",
            "description": "Email address of the registered user",
            "example": "user@example.com"
          },
          "waitlistId": {
            "type": "string",
            "description": "Waitlist ID this user belongs to",
            "example": "507f1f77bcf86cd799439011"
          },
          "referredBy": {
            "type": "string",
            "description": "Referral code of the user who referred this signup",
            "example": "ref_abc123xyz"
          },
          "referral_code": {
            "type": "string",
            "description": "Unique referral code for this user to share",
            "example": "ref_xyz789abc"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Registration timestamp",
            "example": "2024-01-15T10:30:00.000Z"
          }
        },
        "required": [
          "_id",
          "email",
          "waitlistId",
          "referral_code",
          "createdAt"
        ]
      },
      "WaitListUserCountResponseDto": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number",
            "description": "Total number of users in the waitlist",
            "example": 1250
          },
          "referred": {
            "type": "number",
            "description": "Number of users who signed up via referral",
            "example": 320
          }
        },
        "required": [
          "total",
          "referred"
        ]
      },
      "CreateEmailTemplateDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateEmailTemplateDto": {
        "type": "object",
        "properties": {}
      },
      "SendEmailDto": {
        "type": "object",
        "properties": {}
      }
    }
  }
}